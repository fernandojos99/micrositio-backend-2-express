# Copiar a src/.env y rellenar. El .env va en src/, no en la raíz del paquete
# (lo carga src/config/entorno.js, y solo si NODE_ENV != production).

# --- Base de datos (obligatoria: sin ella el proceso hace process.exit(1)) ---
# Cualquier PostgreSQL. El backend habla SQL directo con él mediante `pg`.
DATABASE_URL=postgres://usuario:clave@localhost:5432/micrositio
# Conexiones máximas del pool (por defecto 10; en Lambda conviene bajarlo)
PG_POOL_MAX=

# --- Archivos subidos (documentos, formatos, fotos de perfil) ---
# Se guardan en disco y el backend los sirve en /archivos. En Lambda o Render
# el disco no es persistente: monta ahí un disco persistente.
# Directorio (por defecto <paquete>/uploads)
ARCHIVOS_DIR=
# URL pública del backend con la que se construyen los enlaces que se guardan
# en la base (por defecto http://localhost:$PORT). Sin "/" final.
ARCHIVOS_URL_BASE=http://localhost:3001

# --- Servidor ---
PORT=3001                 # el frontend tiene http://localhost:3001 hardcodeado en src/apiClient.ts
NODE_ENV="development"

# --- JWT ---
# Si se omite, src/config/jwtConfig.js usa el fallback hardcodeado
# 'tu-clave-secreta-muy-segura', que es publico y esta en el repo.
# DEFINIRLA SIEMPRE, sobre todo en produccion.
JWT_SECRET=

# --- Correo (nodemailer, notificaciones) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- Agente IA (proxy SSE de POST /api/chat/stream) ---
# Si se omite, src/config/agentConfig.js usa una Lambda Function URL por defecto.
# Sin "/" final ni espacios.
AGENT_API_URL=
