# Copiar a src/.env.produccion y rellenar. Se carga ENCIMA de src/.env cuando
# ENTORNO=produccion (ver src/config/entorno.js): solo sustituye lo que define.
# En Vercel no se lee ningún .env: estas mismas variables van en su dashboard.

# Transaction pooler de Supabase (puerto 6543), el adecuado para serverless
DATABASE_URL=postgresql://postgres.<proyecto>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres
# TLS validado contra la CA de Supabase (versionada en el repo)
PG_SSL_CA=src/config/certs/supabase-root-2021.crt
PG_POOL_MAX=2

# Archivos en Supabase Storage. Clave service_role: solo en el backend
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_KEY=

# El mismo valor que en Vercel, para que los tokens sirvan en ambos
JWT_SECRET=
