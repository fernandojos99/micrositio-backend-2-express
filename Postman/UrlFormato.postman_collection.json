					"name": "1. Crear URL formato",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('id_url_formato', response.id_url_formato);",
									"    console.log('URL formato creada - ID:', response.id_url_formato);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"url\": \"https://example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/url-formato/crear",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"url-formato",
								"crear"
							]
						}
					},
					"response": []
				},
