							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n  \"success\": true,\n  \"mensaje\": \"Notificación enviada exitosamente\",\n  \"data\": {\n    \"destinatario\": {\n      \"nombre\": \"Juan Pérez\",\n      \"email\": \"juan.perez@empresa.com\"\n    },\n    \"remitente\": {\n      \"nombre\": \"María González\"\n    },\n    \"proyecto\": \"Sistema de Gestión Empresarial\",\n    \"secuencia\": \"Fase de Testing Alpha\",\n    \"experimentoActual\": \"Pruebas de Usabilidad\",\n    \"experimentoSiguiente\": \"Pruebas de Performance\",\n    \"email\": {\n      \"messageId\": \"<unique-message-id>\",\n      \"enviado\": true\n    }\n  }\n}"
						}
					],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has success property', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test('Response contains notification details', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('destinatario');",
									"    pm.expect(jsonData.data).to.have.property('remitente');",
									"    pm.expect(jsonData.data).to.have.property('email');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
