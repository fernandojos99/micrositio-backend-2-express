							"mode": "raw",
							"raw": "{\n  \"alias\": \"tu_usuario\",\n  \"password\": \"tu_password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
